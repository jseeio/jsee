#!/usr/bin/env node
const gen = require('../src/cli.js')
const args = process.argv.slice(2)
const write = process.stdout.write.bind(process.stdout)
if (args[0] === 'serve' && require('minimist')(args.slice(1), { boolean: ['mcp-only'] })['mcp-only']) {
  const { Writable } = require('stream')
  const wire = new Writable({ write: (chunk, encoding, callback) => write(chunk, encoding, callback) })
  process.stdout.write = process.stderr.write.bind(process.stderr)
  try { require('../src/mcp').serve(args, wire) } catch (error) { console.error(error.message); process.exitCode = 1 }
} else if (['inspect', 'validate', 'run', 'artifact-import'].includes(args[0])) {
  // The command owns this process: model diagnostics must never corrupt JSON stdout.
  process.stdout.write = process.stderr.write.bind(process.stderr)
  gen.command(args).then(({ body, exitCode }) => {
    write(JSON.stringify(body) + '\n')
    process.exitCode = exitCode
  }).catch(error => { console.error(error.message); process.exitCode = 1 })
} else gen(args).then(server => {
  if (args[0] === 'serve' && server) {
    for (const signal of ['SIGINT', 'SIGTERM']) process.once(signal, () => server.close(() => process.exit(0)))
  }
}).catch(error => { console.error(error.message); process.exitCode = 1 })
